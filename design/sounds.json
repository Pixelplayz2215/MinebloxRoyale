{
  "sheet": "sounds",
  "class": "SoundDef",
  "about": "Every sound the mashup plays. game=roblox: read from the player's own Roblox install (content/sounds/<file>) at runtime, decoded in memory. game=minecraft: a vanilla sound event. Fortnite audio comes only from its unencrypted movies (media sheet).",
  "columns": { "id": "string", "game": "enum:roblox|minecraft", "file": "string", "volume": "float", "pitch": "float", "use": "string" },
  "rows": [
    { "id": "oof", "game": "roblox", "file": "sounds/oof.ogg", "volume": 1.0, "pitch": 1.0, "use": "a player or bot is eliminated" },
    { "id": "jump", "game": "roblox", "file": "sounds/action_jump.mp3", "volume": 0.6, "pitch": 1.0, "use": "any avatar jumps" },
    { "id": "land", "game": "roblox", "file": "sounds/action_jump_land.mp3", "volume": 0.5, "pitch": 1.0, "use": "any avatar lands from a jump" },
    { "id": "step", "game": "roblox", "file": "sounds/action_footsteps_plastic.mp3", "volume": 0.35, "pitch": 1.0, "use": "footsteps in the hub and on the obby" },
    { "id": "getup", "game": "roblox", "file": "sounds/action_get_up.mp3", "volume": 0.8, "pitch": 1.0, "use": "respawn at an obby checkpoint" },
    { "id": "falling", "game": "roblox", "file": "sounds/action_falling.ogg", "volume": 0.7, "pitch": 1.0, "use": "falling off the obby or skydiving" },
