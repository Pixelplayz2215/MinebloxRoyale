    { "id": "fire_shotgun", "game": "minecraft", "file": "entity.generic.explode", "volume": 0.5, "pitch": 1.9, "use": "pump shotgun shot" },
    { "id": "fire_smg", "game": "minecraft", "file": "entity.firework_rocket.blast", "volume": 0.7, "pitch": 1.9, "use": "SMG shot" },
    { "id": "fire_pistol", "game": "minecraft", "file": "entity.firework_rocket.blast", "volume": 0.8, "pitch": 1.4, "use": "pistol shot" },
    { "id": "fire_sniper", "game": "minecraft", "file": "entity.firework_rocket.large_blast", "volume": 1.0, "pitch": 0.8, "use": "sniper shot" },
