    { "id": "reload", "game": "minecraft", "file": "item.crossbow.loading_middle", "volume": 0.8, "pitch": 1.2, "use": "reloading" },
    { "id": "use_heal", "game": "minecraft", "file": "entity.generic.eat", "volume": 0.5, "pitch": 1.0, "use": "bandages / med kit: Minecraft eating sound while used" },
    { "id": "use_shield", "game": "minecraft", "file": "entity.generic.drink", "volume": 0.8, "pitch": 1.0, "use": "shields and Chug Jug: Minecraft drinking sound while used" },
    { "id": "storm_warning", "game": "minecraft", "file": "block.note_block.bell", "volume": 0.9, "pitch": 0.6, "use": "plays once, briefly, each time the storm starts shrinking (no storm music)" },
    { "id": "hit_marker", "game": "minecraft", "file": "entity.arrow.hit_player", "volume": 0.6, "pitch": 1.3, "use": "your shot hit someone" },
