    { "id": "h_stone", "match": "~stone", "where": "anywhere", "collapse": "single", "material": "brick", "perBlock": 3, "maxBlocks": 1 },
    { "id": "h_copper", "match": "*copper", "where": "anywhere", "collapse": "wall", "material": "metal", "perBlock": 4, "maxBlocks": 80 },
    { "id": "h_copper_block", "match": "*copper_block", "where": "anywhere", "collapse": "wall", "material": "metal", "perBlock": 4, "maxBlocks": 80 },
    { "id": "h_copper_grate", "match": "*copper_grate", "where": "anywhere", "collapse": "wall", "material": "metal", "perBlock": 4, "maxBlocks": 80 },
    { "id": "h_iron_door", "match": "minecraft:iron_door", "where": "anywhere", "collapse": "wall", "material": "metal", "perBlock": 4, "maxBlocks": 80 },
    { "id": "h_iron_trapdoor", "match": "minecraft:iron_trapdoor", "where": "anywhere", "collapse": "wall", "material": "metal", "perBlock": 4, "maxBlocks": 80 },
    { "id": "h_car", "match": "@car", "where": "structure", "collapse": "car", "material": "metal", "perBlock": 10, "maxBlocks": 6 },
    { "id": "h_building_any", "match": "@any", "where": "structure", "collapse": "wall", "material": "brick", "perBlock": 3, "maxBlocks": 120 }
  ]
}
