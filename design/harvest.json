{
  "sheet": "harvest",
  "class": "HarvestRuleDef",
  "about": "What can be broken in a match (Fortnite harvesting), ONLY with the pickaxe. Rows are checked top to bottom; the first match wins. match: block tag (#...), block id, id suffix (*_planks), id containing (~stone) or @any. where: anywhere, or structure = only inside a building (a generated structure such as a village house or ruined portal, or one of Mineblox Royale's own: shack, watchtower, supply depot, ruins), so sand in buildings breaks but the ground never does; every stone block (anything with 'stone' in its name: stone, cobblestone, mossy, smooth, chiseled, sandstone, blackstone...) breaks anywhere for brick, one block at a time (creator). Logs, planks, bricks of every kind and iron blocks break anywhere (creator: always breakable; only trees and buildings have them). collapse: tree = the whole connected tree falls (logs + its leaves); wall = the connected flat wall in the broken block's plane; roof = the connected roof section; attached = things growing on a tree (leaves, vines, cocoa, bee nests, hanging moss, resin, a creaking heart...): removed with the tree that falls (anything it held up goes too, so nothing is left floating), never breakable on their own by players or bots, never give anything; for the leaves row, maxBlocks is the most leaves (and separately the most other extras) one tree drops; single = just the block hit (inside a building stone is a wall: the next row that matches there counts); car = a parked car (row h_car, match @car: any part of a car; each pickaxe hit gives perBlock, and maxBlocks hits wreck it; reboot vans and the Battle Bus never break); none = never breakable. Nothing matching = never breakable (ground). perBlock: materials per fallen block (leaves give nothing). A log touching no natural leaves counts as a house wall.",
  "columns": {
    "id": "string",
    "match": "string",
    "where": "enum:anywhere|structure",
    "collapse": "enum:tree|wall|roof|attached|single|car|none",
    "material": "ref:materials",
    "perBlock": "float",
    "maxBlocks": "int"
  },
  "rows": [
    { "id": "h_logs", "match": "#minecraft:logs", "where": "anywhere", "collapse": "tree", "material": "wood", "perBlock": 5, "maxBlocks": 400 },
    { "id": "h_leaves", "match": "#minecraft:leaves", "where": "anywhere", "collapse": "attached", "material": "wood", "perBlock": 0, "maxBlocks": 2000 },
    { "id": "h_vines", "match": "minecraft:vine", "where": "anywhere", "collapse": "attached", "material": "wood", "perBlock": 0, "maxBlocks": 0 },
    { "id": "h_cocoa", "match": "minecraft:cocoa", "where": "anywhere", "collapse": "attached", "material": "wood", "perBlock": 0, "maxBlocks": 0 },
    { "id": "h_bee_nest", "match": "minecraft:bee_nest", "where": "anywhere", "collapse": "attached", "material": "wood", "perBlock": 0, "maxBlocks": 0 },
    { "id": "h_propagule", "match": "minecraft:mangrove_propagule", "where": "anywhere", "collapse": "attached", "material": "wood", "perBlock": 0, "maxBlocks": 0 },
    { "id": "h_hanging_moss", "match": "minecraft:pale_hanging_moss", "where": "anywhere", "collapse": "attached", "material": "wood", "perBlock": 0, "maxBlocks": 0 },
    { "id": "h_resin", "match": "minecraft:resin_clump", "where": "anywhere", "collapse": "attached", "material": "wood", "perBlock": 0, "maxBlocks": 0 },
    { "id": "h_creaking_heart", "match": "minecraft:creaking_heart", "where": "anywhere", "collapse": "attached", "material": "wood", "perBlock": 0, "maxBlocks": 0 },
    { "id": "h_ground_dirt", "match": "#minecraft:dirt", "where": "anywhere", "collapse": "none", "material": "wood", "perBlock": 0, "maxBlocks": 0 },
    { "id": "h_ground_path", "match": "minecraft:dirt_path", "where": "anywhere", "collapse": "none", "material": "wood", "perBlock": 0, "maxBlocks": 0 },
    { "id": "h_ground_farm", "match": "minecraft:farmland", "where": "anywhere", "collapse": "none", "material": "wood", "perBlock": 0, "maxBlocks": 0 },
    { "id": "h_ground_gravel", "match": "minecraft:gravel", "where": "anywhere", "collapse": "none", "material": "wood", "perBlock": 0, "maxBlocks": 0 },
    { "id": "h_ground_snow", "match": "minecraft:snow_block", "where": "anywhere", "collapse": "none", "material": "wood", "perBlock": 0, "maxBlocks": 0 },
    { "id": "h_ground_snow_layer", "match": "minecraft:snow", "where": "anywhere", "collapse": "none", "material": "wood", "perBlock": 0, "maxBlocks": 0 },
    { "id": "h_ground_water", "match": "minecraft:water", "where": "anywhere", "collapse": "none", "material": "wood", "perBlock": 0, "maxBlocks": 0 },
